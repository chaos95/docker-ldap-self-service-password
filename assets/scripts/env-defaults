#!/bin/sh

DEBUG=${DEBUG:-$DEBUG_ENTRYPOINT}


## GENERAL
SERVER_HOSTNAME=${SERVER_HOSTNAME:-$HOSTNAME}

## LDAP
LDAP_URL=${LDAP_URL:-ldap}
LDAP_BASE=${LDAP_BASE:-example.com}
if [ -z ${LDAP_USER} ] ; then LDAP_USER="cn=admin,${LDAP_BASE}"; fi
LDAP_PASS=${LDAP_PASS:-admin}
LDAP_STARTTLS=${LDAP_STARTTLS:-true}
LDAP_AD_MODE=${LDAP_AD_MODE:-false}
LDAP_SAMBA_MODE=${LDAP_SAMBA_MODE:-false}

## MAIL
SMTP_HOST=${SMTP_HOST:-smtp}
SMTP_PORT=${SMTP_PORT:-25}
SMTP_USER=${SMTP_USER:-}
SMTP_PASS=${SMTP_PASS:-}

if [ -z "${SMTP_USER}" ] && [ -z "${SMTP_PASS}" ]; then
  SMTP_REQUIRESAUTH=false
else
  SMTP_REQUIRESAUTH=true
fi

SMTP_FROM=${SMTP_FROM:-root@$ERVER_HOSTNAME}
SMTP_TLS=${SMTP_TLS:-false}
SMTP_TYPE=${SMTP_TYPE:-noauth}

## LDAP-SSP
LSSP_MAIL_SUPPORT=false
LSSP_ATTR_LOGIN=${LSSP_ATTR_LOGIN:-uid}
LSSP_ATTR_FN=${LSSP_ATTR_FN:-cn}
LSSP_ATTR_MAIL=${LSSP_ATTR_MAIL:-mail}
LSSP_HASH_METHOD=${LSSP_HASH_METHOD:-auto}
LSSP_DEFAULT_ACTION=${LSSP_DEFAULT_ACTION:-change}
LSSP_SHOW_MENU=${LSSP_SHOW_MENU:-true}
LSSP_MAIL_FROM_LDAP=${LSSP_MAIL_FROM_LDAP:-false}
if [ -z "${LSSP_ACCOUNT_FILTER}" ]; then
  LSSP_ACCOUNT_FILTER='(&(objectClass=person)($ldap_login_attribute={login}))'
fi

## reCAPTCHA
RECAPTCHA_USE=${RECAPTCHA_USE:-false};
RECAPTCHA_PUB_KEY=${RECAPTCHA_PUB_KEY};
RECAPTCHA_PRV_KEY=${RECAPTCHA_PRV_KEY};
RECAPTCHA_THEME=${RECAPTCHA_THEME:-white};
RECAPTCHA_SSL=${RECAPTCHA_USE:-false};


## Local password policy
# This is applied before directory password policy
# Minimal length
PWD_MIN_LENGTH=${PWD_MIN_LENGTH:-0};
# Maximal length
PWD_MAX_LENGTH=${PWD_MAX_LENGTH:-0};
# Minimal lower characters
PWD_MIN_LOWER=${PWD_MIN_LOWER:-0};
# Minimal upper characters
PWD_MIN_UPPER=${PWD_MIN_UPPER:-0};
# Minimal digit characters
PWD_MIN_DIGIT=${PWD_MIN_DIGIT:-0};
# Minimal special characters
PWD_MIN_SPECIAL=${PWD_MIN_SPECIAL:-0};
# Definition of special characters
PWD_SPECIAL_CHARS=${PWD_SPECIAL_CHARS:-"^a-zA-Z0-9"};
# Forbidden characters
#PWD_FORBIDDEN_CHARS=${PWD_FORBIDDEN_CHARS:-"@%"};
# Don't reuse the same password as currently
PWD_NO_REUSE=${PWD_NO_REUSE:-true};
# Complexity: number of different class of character required
PWD_COMPLEXITY=${PWD_COMPLEXITY:-0};
# Show policy constraints message:
# always
# never
# onerror
PWD_SHOW_POLICY=${PWD_SHOW_POLICY:-"onerror"};
# Position of password policy constraints message:
# above - the form
# below - the form
PWD_SHOW_POLICY_POS=${PWD_SHOW_POLICY_POS:-"below"};

